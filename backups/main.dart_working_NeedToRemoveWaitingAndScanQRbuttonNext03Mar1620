  bool isNavigating = false;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      extendBodyBehindAppBar: true,
      appBar: const _KTAppBar(showBack: true),
      body: Stack(
        children: [
          MobileScanner(
            onDetect: (capture) {
              if (isNavigating) return;
              final code = capture.barcodes.first.rawValue;
              if (code != null) {
                isNavigating = true;
                final channel = WebSocketChannel.connect(Uri.parse(SIGNAL_SERVER));
                Navigator.pushReplacement(
                  context,
                  MaterialPageRoute(
                    builder: (_) => CallScreen(
                      roomId: code,
                      isHost: false,
                      channel: channel,
                    ),
                  ),
                );
              }
            },
          ),
          // Overlay with cutout
          _ScannerOverlay(),
        ],
      ),
    );
  }
}

