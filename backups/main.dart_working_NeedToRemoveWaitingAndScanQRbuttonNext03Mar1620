class _CornerPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = KT.gold
      ..strokeWidth = 3
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round;

    const len = 28.0;
    const r = 8.0;

    // Top-left
    canvas.drawLine(Offset(r, 0), Offset(len, 0), paint);
    canvas.drawLine(Offset(0, r), Offset(0, len), paint);
    canvas.drawArc(const Rect.fromLTWH(0, 0, r * 2, r * 2),
        -3.14159, 3.14159 / 2, false, paint);

    // Top-right
    canvas.drawLine(Offset(size.width - len, 0), Offset(size.width - r, 0), paint);
    canvas.drawLine(Offset(size.width, r), Offset(size.width, len), paint);
    canvas.drawArc(Rect.fromLTWH(size.width - r * 2, 0, r * 2, r * 2),
        -3.14159 / 2, 3.14159 / 2, false, paint);

    // Bottom-left
    canvas.drawLine(Offset(0, size.height - len), Offset(0, size.height - r), paint);
    canvas.drawLine(Offset(r, size.height), Offset(len, size.height), paint);
    canvas.drawArc(Rect.fromLTWH(0, size.height - r * 2, r * 2, r * 2),
        3.14159 / 2, 3.14159 / 2, false, paint);

    // Bottom-right
    canvas.drawLine(
        Offset(size.width, size.height - len),
        Offset(size.width, size.height - r), paint);
    canvas.drawLine(
        Offset(size.width - len, size.height),
        Offset(size.width - r, size.height), paint);
    canvas.drawArc(
        Rect.fromLTWH(size.width - r * 2, size.height - r * 2, r * 2, r * 2),
        0, 3.14159 / 2, false, paint);
  }

  @override
  bool shouldRepaint(_) => false;
}

// ══════════════════════════════════════════════════════
// CALL SCREEN
// ══════════════════════════════════════════════════════
class CallScreen extends StatefulWidget {
  final String roomId;
  final bool isHost;
  final WebSocketChannel channel;
  final Stream<dynamic>? broadcastStream;

  const CallScreen({
    super.key,
    required this.roomId,
    required this.isHost,
    required this.channel,
    this.broadcastStream,
  });

  @override
  State<CallScreen> createState() => _CallScreenState();
}

class _CallScreenState extends State<CallScreen> {
  RTCVideoRenderer? _localRenderer;
  RTCVideoRenderer? _remoteRenderer;
  RTCPeerConnection? _peerConnection;
  MediaStream? _localStream;

  // Call timer
  int _seconds = 0;
  Timer? _timer;

  // Controls state
  bool _muted    = false;
  bool _camOff   = false;
  String _facingMode = 'user';

  final Map<String, dynamic> iceConfig = {
    'iceServers': [
      {'urls': 'stun:stun.l.google.com:19302'},
      {
        'urls': [
          'turn:knocktalk.duckdns.org:3478',
          'turns:knocktalk.duckdns.org:5349'
        ],
        'username': TURN_USERNAME,
        'credential': TURN_PASSWORD,
      }
    ]
  };

  @override
  void initState() {
    super.initState();
    _timer = Timer.periodic(const Duration(seconds: 1), (_) {
      if (mounted) setState(() => _seconds++);
    });
    _start();
  }

  Future<void> _start() async {
    await _initRenderers();
    _listenToSignaling();
    if (widget.isHost) {
      await _createPeerConnection();
      widget.channel.sink.add(jsonEncode({
        'type': 'host-answer-ready',
        'roomId': widget.roomId,
      }));
    } else {
      widget.channel.sink.add(jsonEncode({
        'type': 'guest-join',
        'roomId': widget.roomId,
      }));
    }
  }

  Future<void> _initRenderers() async {
    await Permission.camera.request();
    await Permission.microphone.request();

    _localRenderer = RTCVideoRenderer();
    _remoteRenderer = RTCVideoRenderer();
    await _localRenderer!.initialize();
    await _remoteRenderer!.initialize();

    _localStream = await navigator.mediaDevices.getUserMedia({
      'audio': true,
      'video': {'facingMode': 'user', 'width': 640, 'height': 480, 'frameRate': 30},
    });
    _localRenderer!.srcObject = _localStream;
    if (mounted) setState(() {});
  }

  void _listenToSignaling() {
    final stream = widget.broadcastStream ?? widget.channel.stream;
    stream.listen((message) async {
      final data = jsonDecode(message);

      if (data['type'] == 'create-offer') {
        final offer = await _peerConnection!.createOffer();
        await _peerConnection!.setLocalDescription(offer);
        widget.channel.sink.add(jsonEncode({
          'type': 'signal',
          'roomId': widget.roomId,
          'signal': offer.toMap(),
        }));
      }

      if (data['type'] == 'signal') {
        final signal = data['signal'];
        if (signal['type'] == 'offer') {
          await _createPeerConnection();
          await _peerConnection!.setRemoteDescription(
              RTCSessionDescription(signal['sdp'], signal['type']));
          final answer = await _peerConnection!.createAnswer();
          await _peerConnection!.setLocalDescription(answer);
          widget.channel.sink.add(jsonEncode({
            'type': 'signal',
            'roomId': widget.roomId,
            'signal': answer.toMap(),
          }));
        }
        if (signal['type'] == 'answer') {
          await _peerConnection!.setRemoteDescription(
              RTCSessionDescription(signal['sdp'], signal['type']));
        }
        if (signal['candidate'] != null && _peerConnection != null) {
          await _peerConnection!.addCandidate(RTCIceCandidate(
            signal['candidate'],
            signal['sdpMid'],
            signal['sdpMLineIndex'],
          ));
        }
      }

      if (data['type'] == 'guest-disconnected' && mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            backgroundColor: KT.panel,
            content: const Text('Visitor has disconnected',
                style: TextStyle(color: KT.text)),
          ),
        );
      }
    });
  }

  Future<void> _createPeerConnection() async {
    if (_peerConnection != null) return;
    _peerConnection = await createPeerConnection(iceConfig);
    _localStream?.getTracks().forEach((t) =>
        _peerConnection?.addTrack(t, _localStream!));

    _peerConnection?.onIceCandidate = (candidate) {
      if (candidate != null) {
        widget.channel.sink.add(jsonEncode({
          'type': 'signal',
          'roomId': widget.roomId,
          'signal': {
            'candidate': candidate.candidate,
            'sdpMid': candidate.sdpMid,
            'sdpMLineIndex': candidate.sdpMLineIndex,
          }
        }));
      }
    };

    _peerConnection!.onTrack = (RTCTrackEvent event) {
      if (event.streams.isNotEmpty) {
        // Assign on every track event — this ensures both audio and video
        // tracks from the remote stream are captured by the renderer.
        _remoteRenderer!.srcObject = event.streams[0];
        if (mounted) setState(() {});
      }
    };
  }

  void _toggleMute() {
    _muted = !_muted;
    _localStream?.getAudioTracks().forEach((t) => t.enabled = !_muted);
    if (mounted) setState(() {});
  }

  void _toggleCam() {
    _camOff = !_camOff;
    _localStream?.getVideoTracks().forEach((t) => t.enabled = !_camOff);
    // Nudge the renderer so it picks up the enabled state change
    if (_localRenderer != null) {
      final current = _localRenderer!.srcObject;
      _localRenderer!.srcObject = null;
      _localRenderer!.srcObject = current;
    }
    if (mounted) setState(() {});
  }

  Future<void> _flipCamera() async {
    if (_localStream == null || _localRenderer == null) return;
    _facingMode = _facingMode == 'user' ? 'environment' : 'user';

    // Stop existing video tracks
    _localStream!.getVideoTracks().forEach((t) => t.stop());

    // Get a full new stream (video + audio) with the new facing mode
    final newStream = await navigator.mediaDevices.getUserMedia({
      'audio': true,
      'video': {
        'facingMode': _facingMode,
        'width': 640,
        'height': 480,
        'frameRate': 30,
      },
    });

    final newVideoTrack = newStream.getVideoTracks().first;

    // Replace both video AND audio senders so the guest continues
    // receiving the host's audio from the new stream after a flip.
    if (_peerConnection != null) {
      final senders = await _peerConnection!.getSenders();
      final newAudioTrack = newStream.getAudioTracks().isNotEmpty
          ? newStream.getAudioTracks().first
          : null;
      for (final sender in senders) {
        if (sender.track?.kind == 'video') {
          await sender.replaceTrack(newVideoTrack);
        } else if (sender.track?.kind == 'audio' && newAudioTrack != null) {
          await sender.replaceTrack(newAudioTrack);
        }
      }
    }

    // Assign the brand-new stream directly to the renderer —
    // flutter_webrtc reliably reacts to a new srcObject reference.
    _localStream = newStream;
    _localRenderer!.srcObject = null;        // force a reset
    _localRenderer!.srcObject = _localStream; // then assign fresh

    if (mounted) setState(() {});
  }

  @override
  void dispose() {
    _timer?.cancel();
    if (widget.isHost) {
      try {
        widget.channel.sink.add(jsonEncode({
          'type': 'host-end-call',
          'roomId': widget.roomId,
        }));
      } catch (_) {}
    }
    _localRenderer?.dispose();
    _remoteRenderer?.dispose();
    _peerConnection?.close();
    _localStream?.getTracks().forEach((t) => t.stop());
    _localStream?.dispose();
    widget.channel.sink.close();
    super.dispose();
  }

  String _formatTime(int s) =>
      '${(s ~/ 60).toString().padLeft(2, '0')}:${(s % 60).toString().padLeft(2, '0')}';

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
