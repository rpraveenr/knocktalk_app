// WAITING SCREEN
// ══════════════════════════════════════════════════════
class WaitingScreen extends StatefulWidget {
  final bool autoIncomingCall;
  const WaitingScreen({super.key, this.autoIncomingCall = false});

  @override
  State<WaitingScreen> createState() => _WaitingScreenState();
}

class _WaitingScreenState extends State<WaitingScreen>
    with SingleTickerProviderStateMixin {
  late WebSocketChannel _channel;
  late Stream<dynamic> _broadcastStream;
  bool _incomingCall = false;
  bool _answered = false;

  late AnimationController _ringCtrl;
  late Animation<double> _ringAnim;

  @override
  void initState() {
    super.initState();
    _ringCtrl = AnimationController(
        vsync: this, duration: const Duration(milliseconds: 2000))
      ..repeat();
    _ringAnim = Tween(begin: 0.0, end: 1.0).animate(_ringCtrl);

    if (widget.autoIncomingCall) _incomingCall = true;
    _listenForCalls();
  }

  void _listenForCalls() {
    _channel = WebSocketChannel.connect(Uri.parse(SIGNAL_SERVER));
    _broadcastStream = _channel.stream.asBroadcastStream();
    _channel.sink.add(jsonEncode({'type': 'host-listen', 'roomId': MY_ROOM_ID}));

    _broadcastStream.listen(
      (message) {
        final data = jsonDecode(message);
        if (data['type'] == 'incoming-call' && mounted) setState(() => _incomingCall = true);
      },
      onDone: () {
        if (!_answered && mounted) {
          Future.delayed(const Duration(seconds: 2), () {
            if (!_answered && mounted) _listenForCalls();
          });
        }
      },
    );
  }

  void _answerCall() {
    _answered = true;
    _ringCtrl.stop();
    _channel.sink.add(jsonEncode({'type': 'host-answer', 'roomId': MY_ROOM_ID}));
    Navigator.pushReplacement(context, MaterialPageRoute(
      builder: (_) => CallScreen(
        roomId: MY_ROOM_ID,
        isHost: true,
        channel: _channel,
        broadcastStream: _broadcastStream,
      ),
    ));
  }

  void _rejectCall() {
    if (mounted) setState(() => _incomingCall = false);
  }

  @override
  void dispose() {
    _ringCtrl.dispose();
    if (!_answered) _channel.sink.close();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      extendBodyBehindAppBar: true,
      appBar: const _KTAppBar(showBack: true),
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [Color(0xFF0F1420), KT.bg],
          ),
        ),
        child: SafeArea(
          child: _incomingCall
              ? _buildIncomingCall()
              : _buildListening(),
        ),
      ),
    );
  }

  // ── Idle — listening state ──────────────────────────
  Widget _buildListening() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 32),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          // Animated ring
          SizedBox(
            width: 160, height: 160,
            child: AnimatedBuilder(
              animation: _ringAnim,
              builder: (_, __) => Stack(
                alignment: Alignment.center,
                children: [
                  ...[0.0, 0.33, 0.66].map((offset) {
                    final t = (_ringAnim.value + offset) % 1.0;
                    return Opacity(
                      opacity: (1 - t).clamp(0, 1),
                      child: Transform.scale(
                        scale: 0.5 + t * 0.8,
                        child: Container(
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            border: Border.all(
                                color: KT.gold.withOpacity(0.25), width: 1),
                          ),
                        ),
                      ),
                    );
                  }),
                  Container(
                    width: 90, height: 90,
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: KT.panel,
                      border: Border.all(
                          color: KT.gold.withOpacity(0.3), width: 1),
                      boxShadow: [
                        BoxShadow(
                          color: KT.gold.withOpacity(0.12),
                          blurRadius: 30,
                        )
                      ],
                    ),
                    child: const Icon(Icons.sensors_rounded,
                        color: KT.gold, size: 36),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 36),
          const Text('Listening',
              style: TextStyle(
                  color: KT.text,
                  fontSize: 24,
                  fontWeight: FontWeight.w500,
                  letterSpacing: 0.2)),
          const SizedBox(height: 10),
          Text(
            'You\'ll be notified when someone\nscans your door QR code.',
            textAlign: TextAlign.center,
            style: TextStyle(
                color: KT.muted.withOpacity(0.8),
                fontSize: 14,
                height: 1.6),
          ),
          const SizedBox(height: 40),
          const _Pill('Waiting for visitor'),
        ],
      ),
    );
  }

  // ── Incoming call state ─────────────────────────────
  Widget _buildIncomingCall() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 32),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          // Pulsing avatar
          _IncomingAvatar(),
          const SizedBox(height: 32),
          const Text('Someone\'s at the door',
              style: TextStyle(
                  color: KT.text,
                  fontSize: 22,
                  fontWeight: FontWeight.w500,
                  letterSpacing: 0.2)),
          const SizedBox(height: 10),
          Text('A visitor is waiting outside.',
              style: TextStyle(
                  color: KT.muted.withOpacity(0.8), fontSize: 14)),
          const SizedBox(height: 56),

          // Answer / Decline row
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              // Decline
              Column(children: [
                _CtrlBtn(
                  icon: Icons.call_end_rounded,
                  bg: KT.red.withOpacity(0.15),
                  iconColor: KT.red,
                  size: 68,
                  onTap: _rejectCall,
                ),
                const SizedBox(height: 10),
                const Text('Decline',
                    style: TextStyle(color: KT.muted, fontSize: 13)),
              ]),

              const SizedBox(width: 60),

              // Answer
              Column(children: [
                _CtrlBtn(
                  icon: Icons.call_rounded,
                  bg: KT.green.withOpacity(0.2),
                  iconColor: KT.green,
                  size: 68,
                  onTap: _answerCall,
                ),
                const SizedBox(height: 10),
                const Text('Answer',
                    style: TextStyle(color: KT.muted, fontSize: 13)),
              ]),
            ],
          ),
        ],
      ),
    );
  }
}

