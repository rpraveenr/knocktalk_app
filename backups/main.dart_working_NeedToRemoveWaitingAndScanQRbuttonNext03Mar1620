                            color: KT.green, shape: BoxShape.circle),
                        ),
                        const SizedBox(width: 7),
                        Text('Connected · ${_formatTime(_seconds)}',
                            style: const TextStyle(
                                color: KT.green,
                                fontSize: 12,
                                letterSpacing: 0.5)),
                      ]),
                    ),
                  ],
                ),
              ),
            ),
          ),

          // ── Local PiP ─────────────────────────────────────────
          if (_localRenderer != null)
            Positioned(
              top: 100, right: 16,
              width: 90, height: 120,
              child: ClipRRect(
                borderRadius: BorderRadius.circular(14),
                child: Container(
                  decoration: BoxDecoration(
