                SizedBox(height: 20),
                Text('Connecting…',
                    style: TextStyle(color: KT.muted, fontSize: 14)),
              ]),
            ),

          // ── Top gradient ──────────────────────────────────────
          Positioned(
            top: 0, left: 0, right: 0, height: 160,
            child: Container(
              decoration: const BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.topCenter,
                  end: Alignment.bottomCenter,
                  colors: [Color(0xCC0C0F14), Colors.transparent],
                ),
              ),
            ),
          ),

          // ── Bottom gradient ───────────────────────────────────
          Positioned(
            bottom: 0, left: 0, right: 0, height: 240,
            child: Container(
              decoration: const BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.bottomCenter,
                  end: Alignment.topCenter,
                  colors: [Color(0xF00C0F14), Colors.transparent],
                ),
              ),
            ),
          ),

          // ── Top bar with timer ────────────────────────────────
          Positioned(
            top: 0, left: 0, right: 0,
            child: SafeArea(
              child: Padding(
                padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Row(children: [
                      Container(
                        width: 7, height: 7,
                        decoration: const BoxDecoration(
                            color: KT.gold, shape: BoxShape.circle),
                      ),
                      const SizedBox(width: 8),
                      const Text('KnockTalk',
                          style: TextStyle(
                              color: KT.gold,
                              fontSize: 16,
                              fontWeight: FontWeight.w500)),
                    ]),
                    Container(
                      padding: const EdgeInsets.symmetric(
                          horizontal: 14, vertical: 6),
                      decoration: BoxDecoration(
                        color: KT.panel.withOpacity(0.85),
                        borderRadius: BorderRadius.circular(40),
                        border: Border.all(color: KT.border),
                      ),
                      child: Row(mainAxisSize: MainAxisSize.min, children: [
